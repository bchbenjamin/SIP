# ─── MQTT Broker (configure your production broker) ───────────────────────────
# Use ssl:// or mqtts:// for TLS. Examples:
#   HiveMQ Cloud: ssl://xxx.hivemq.cloud:8883
#   Mosquitto:    ssl://your-mosquitto.example.com:8883
MQTT_BROKER_URL=ssl://your-mqtt-broker.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=
# Set to true for TLS connections (ssl:// or mqtts://)
MQTT_USE_TLS=true
# TLS options (optional)
MQTT_TLS_CA_CERT=
MQTT_TLS_INSECURE=false

# ─── Backend API ──────────────────────────────────────────────────────────────
# Production: your Render deployment URL
# Dev: http://10.0.2.2:8080/ (Android emulator)
BACKEND_API_URL=https://api.bchbenjamin.in
# Device API key (set on backend via DEVICE_API_KEY env var)
BACKEND_API_KEY=

# ─── Pi Identity ──────────────────────────────────────────────────────────────
PI_NODE_ID=sip-pi-001
# MUST be set to a unique secret per device in production
PI_DEVICE_SECRET=