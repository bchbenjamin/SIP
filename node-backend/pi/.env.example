# ─── MQTT Broker (Mosquitto or hosted like HiveMQ Cloud) ───────────────────────
# Use a public broker for Pi↔backend comms when Pi has dynamic IP
MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=sip-pi-001

# ─── Backend REST API ──────────────────────────────────────────────────────────
# Backend must be publicly accessible (use Cloudflare Tunnel or ngrok)
BACKEND_API_URL=https://your-backend.example.com
BACKEND_API_KEY=your-backend-api-key

# ─── Alert Webhook (legacy, now forwarded via backend) ────────────────────────
ALERT_WEBHOOK_URL=

# ─── Telegram (optional notifications) ───────────────────────────────────────
BOT_TOKEN=
PRIMARY_CHAT_ID=
ALLOWED_CHAT_IDS=

# ─── Pi Identity (auto-discovered at boot) ────────────────────────────────────
PI_NODE_ID=sip-pi-001
PI_DEVICE_SECRET=change-me-in-production