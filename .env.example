# ============================================================
# SIP PROJECT — Canonical Environment Variables
# ============================================================
# This file documents the four canonical env configurations
# used across the SIP project.  Each section is for a different
# subsystem.  Copy the relevant section into the appropriate
# .env file — never commit actual secrets.
# ============================================================

# ─────────────────────────────────────────────────────────
# 1. ANDROID APP  →  android-frontend/.env
# ─────────────────────────────────────────────────────────
# The Android app reads these at build time via Gradle
# (see android/app/build.gradle).
# Secrets (keystore) are NOT here — use env vars at build time.
#
# SIP_API_BASE_URL=https://api.sip.bchbenjamin.in/
# SIP_KEYSTORE_FILE=sip-beta.jks          # relative to android/ dir
# SIP_KEYSTORE_PASSWORD=<keystore-password>
# SIP_KEY_ALIAS=sip-beta
# SIP_KEY_PASSWORD=<key-password>

# ─────────────────────────────────────────────────────────
# 2. SPRING BOOT BACKEND  →  database/backend/.env  (gitignored)
# ─────────────────────────────────────────────────────────
# Local dev only.  Production uses Render dashboard env vars.
#
# DATABASE_URL=jdbc:postgresql://<host>/<db>?user=<user>&password=<pass>&sslmode=require
# JWT_SECRET=<generate: openssl rand -base64 48>
# DEVICE_API_KEY=<generate: openssl rand -base64 48>
# SIP_BOOTSTRAP_ADMIN_USERNAME=bchbenjamin
# SIP_BOOTSTRAP_ADMIN_PASSWORD=<must be ≥12 characters>
# JWT_ACCESS_EXPIRY=900
# JWT_REFRESH_EXPIRY=604800
# SERVER_PORT=8080
# DB_POOL_MAX_SIZE=5
# DB_POOL_MIN_IDLE=0
# NODE_CREDENTIAL_SALT=<generate: openssl rand -base64 48>
# CORS_ALLOWED_ORIGINS=https://kev-ai-device.vercel.app,https://sip.bchbenjamin.in,https://api.sip.bchbenjamin.in
# MQTT_ENABLED=false

# ─────────────────────────────────────────────────────────
# 3. RASPBERRY PI CLIENT  →  node-backend/pi/.env  (gitignored)
# ─────────────────────────────────────────────────────────
# Runs on the Pi.  BACKEND_API_KEY must match DEVICE_API_KEY
# in the backend.
#
# MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=sip-pi-001
# BACKEND_API_URL=https://sip-backend-17b5.onrender.com
# BACKEND_API_KEY=<must match backend DEVICE_API_KEY>
# PI_NODE_ID=sip-pi-001
# PI_DEVICE_SECRET=<unique secret per device>
# BOT_TOKEN=
# PRIMARY_CHAT_ID=
# ALLOWED_CHAT_IDS=

# ─────────────────────────────────────────────────────────
# 4. LANDING PAGE  →  landing-page/.env.local  (auto-created by Vercel CLI)
# ─────────────────────────────────────────────────────────
# Managed by Vercel.  Do not create manually.