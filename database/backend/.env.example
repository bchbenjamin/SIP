# ─── Database (Neon PostgreSQL — JDBC connection string, NOT API key) ──────────
# Neon console → Connection Details → JDBC
# Format: jdbc:postgresql://HOST/DB?user=USER&password=PASSWORD&sslmode=require
DATABASE_URL=jdbc:postgresql://your-host.neon.tech/your-db?user=your-user&password=your-pass&sslmode=require
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0

# ─── JWT (min 32 chars) ────────────────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-here-min-32-characters-long
JWT_ACCESS_EXPIRY=900       # 15 minutes
JWT_REFRESH_EXPIRY=604800   # 7 days

# ─── Bootstrap Admin (created on first run if not exists) ─────────────────────
SIP_BOOTSTRAP_ADMIN_USERNAME=admin
SIP_BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# ─── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── MQTT (Pi ↔ backend communication) ────────────────────────────────────────
# Set MQTT_ENABLED=false to disable MQTT (backend falls back to REST-only)
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=sip-backend
NODE_CREDENTIAL_SALT=random-salt-for-per-node-auth-tokens

# ─── Device Authentication (Pi uses X-API-Key header) ──────────────────────────
# Generate with: openssl rand -hex 32
DEVICE_API_KEY=

# ─── CORS (comma-separated list, no wildcards) ─────────────────────────────────
# Add your Vercel domain and any other frontend origins
CORS_ALLOWED_ORIGINS=https://kev-ai-device.vercel.app