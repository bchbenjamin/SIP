# SIP Backend Environment Configuration
# Copy to database/backend/.env for local development.
# NEVER commit .env — it is gitignored.
#
# ── Database ────────────────────────────────────────────────────────────────
# Get the JDBC URL from Neon Console → Connection Details → Connection string.
# The URL must include user, password (URL-encoded if reserved chars), and sslmode=require.
DATABASE_URL='jdbc:postgresql://<host>/<db>?user=<user>&password=<url-encoded-pass>&sslmode=require'

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a JWT secret: openssl rand -base64 48
JWT_SECRET=<generate-with-openssl-rand-base64-48>

# Bootstrap admin account (both must be set; password must be ≥12 characters).
# After the first deployment this account will exist — remove these vars after that.
SIP_BOOTSTRAP_ADMIN_USERNAME=bchbenjamin
SIP_BOOTSTRAP_ADMIN_PASSWORD=<must-be-12-or-more-characters>

# ── API Security ──────────────────────────────────────────────────────────────
DEVICE_API_KEY=<generate-with-openssl-rand-base64-48>

# Salt for hashing device credentials on the Pi side
NODE_CREDENTIAL_SALT=<generate-with-openssl-rand-base64-48>

# ── JWT Tuning ────────────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRY=900      # 15 minutes
JWT_REFRESH_EXPIRY=604800  # 7 days

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces)
CORS_ALLOWED_ORIGINS=https://kev-ai-device.vercel.app,https://sip.bchbenjamin.in,https://api.sip.bchbenjamin.in

# ── MQTT (currently disabled) ─────────────────────────────────────────────────
MQTT_ENABLED=false